rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    function isCallParticipant(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
          || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
        );
    }

    // Public-to-signed-in profile directory: keep only display name/email here.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A chat document must contain exactly the two participants.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        allow update, delete: if false;
      }
    }

    // Statuses are visible to signed-in users and expire in the client after 24h.
    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.expiresAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Signaling data for audio/video calls and ICE candidates.
    match /calls/{callId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio', 'video'];
      allow update: if signedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read, create: if candidateCollection in ['callerCandidates', 'calleeCandidates']
          && isCallParticipant(callId);
        allow update, delete: if false;
      }
    }
  }
}
